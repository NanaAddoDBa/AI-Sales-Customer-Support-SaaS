{
  "name": "sales-support",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint apps packages scripts tests && node scripts/check-boundaries.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write apps packages scripts tests *.json *.yaml *.mjs .github",
    "format:check": "prettier --check apps packages scripts tests *.json *.yaml *.mjs .github",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
